{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Command Runner",
  "version": "1.0.3",
  "identifier": "com.dev-command-runner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dev Command Runner v1.0.3",
        "width": 800,
        "height": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "dragDropEnabled": false,
        "minWidth": 520,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Dev Command Runner Desktop Utility",
    "longDescription": "A cross-platform desktop dashboard to manage, run, and monitor background development processes.",
    "copyright": "Copyright © 2026 wwwroot. All rights reserved.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}